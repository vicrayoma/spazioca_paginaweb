---
import Page from '../layouts/Page.astro';
import { getSchedule, buildGrid, formatTimeRange, groupSessionsBySlot, TEXT_COLOR_VARS, BG_COLOR_VARS } from '../lib/schedule';
import { whatsappHrefWithText } from '../lib/contact';
import type { ScheduleSession } from '../lib/schedule';

const schedule = await getSchedule();
const grid = buildGrid(schedule);
const updated = new Date(schedule.updatedAt).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Agrupadas por día+franja (dos o más clases pueden compartir exactamente el mismo horario, se
// muestran apiladas en una sola celda) e indexadas para acceso directo fila por fila, igual que el
// tablero del CRM (src/views/horarios/index.ejs), que replica el diseño original del Artifact.
const groupByKey = new Map(
  groupSessionsBySlot(schedule.sessions).map((group) => [`${group[0].day}-${group[0].row}`, group]),
);

function isCovered(day: number, row: number): boolean {
  return schedule.sessions.some((s) => s.day === day && row > s.row && row <= s.row + s.span - 1);
}

function sessionGroupAt(day: number, row: number): ScheduleSession[] | undefined {
  return groupByKey.get(`${day}-${row}`);
}
---

<Page title="Horarios — Spazio Centro Artístico" description="Horario general de clases de Spazio Centro Artístico, de lunes a sábado.">
  <main>
    <section class="intro" data-reveal>
      <h1>Horario general</h1>
      <p>Última actualización: {updated}. ¿Tienes dudas sobre un horario? <a href={whatsappHrefWithText('Hola, tengo una duda sobre el horario general.')} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>.</p>
    </section>

    <div class="poster-wrap" data-reveal>
      <div class="table-wrap">
        <table class="schedule">
          <thead>
            <tr>
              <th>HORA</th>
              {schedule.days.map((day, d) => (
                <th data-day={d}>{day}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {grid.rows.map((row) => (
              <tr>
                <td class="time-cell">{formatTimeRange(schedule.rows[row])}</td>
                {schedule.days.map((_, day) => {
                  if (isCovered(day, row)) return null;
                  const group = sessionGroupAt(day, row);
                  if (!group) return <td class="day-cell empty"></td>;
                  const span = Math.max(...group.map((s) => s.span));
                  const inner = group.map((session) => (
                    <div class="activity" style={`background:${BG_COLOR_VARS[session.bgColor]}; color:${TEXT_COLOR_VARS[session.textColor]};`}>
                      <span class="icon" aria-hidden="true">{session.icon}</span>
                      <span class="name">{session.text}</span>
                    </div>
                  ));
                  return (
                    <td class="day-cell" rowspan={span}>
                      {group.length > 1 ? <div class="stack">{inner}</div> : inner}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Page>

<style>
  .intro {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 3.5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2rem);
    text-align: center;
  }

  .intro h1 {
    color: var(--color-morado);
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
  }

  .intro p {
    margin: 0;
    color: color-mix(in srgb, var(--color-tinta) 75%, white);
  }

  .intro a {
    color: var(--color-magenta);
  }

  .poster-wrap {
    max-width: 74rem;
    margin: 0 auto clamp(3rem, 6vw, 4rem);
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--color-papel);
    border-radius: 1rem;
    box-shadow: 0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--color-morado) 35%, transparent);
  }

  table.schedule {
    width: 100%;
    border-collapse: collapse;
    min-width: 54rem;
  }

  .schedule thead th {
    background: var(--color-morado);
    color: var(--color-papel);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 0.85rem 0.5rem;
    border-right: 1px solid color-mix(in srgb, var(--color-papel) 12%, transparent);
  }

  .schedule thead th:last-child {
    border-right: none;
  }

  .schedule thead th[data-today] {
    background: var(--color-magenta);
  }

  .schedule td {
    border: 1px solid color-mix(in srgb, var(--color-morado) 10%, transparent);
    vertical-align: middle;
    padding: 0;
  }

  .time-cell {
    background: var(--color-niebla);
    padding: 0.55rem 0.75rem !important;
    min-width: 8rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--color-morado);
    white-space: pre-line;
  }

  .day-cell {
    min-width: 8.75rem;
    height: 100%;
    position: relative;
  }

  .day-cell.empty {
    background: var(--color-papel);
  }

  .activity {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    text-align: center;
    padding: 0.55rem 0.6rem;
    height: 100%;
    white-space: pre-line;
  }

  .activity .icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .activity .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .stack {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .stack .activity {
    flex: 1;
  }

  .stack .activity + .activity {
    border-top: 1px solid color-mix(in srgb, var(--color-morado) 10%, transparent);
  }
</style>
