---
import Page from '../layouts/Page.astro';
import { getSchedule, buildGrid, formatTimeRange, STYLE_META } from '../lib/schedule';
import { whatsappHrefWithText } from '../lib/contact';

const schedule = await getSchedule();
const grid = buildGrid(schedule);
const updated = new Date(schedule.updatedAt).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Page title="Horarios — Spazio Centro Artístico" description="Horario general de clases de Spazio Centro Artístico, de lunes a sábado.">
  <main>
    <section class="intro" data-reveal>
      <h1>Horario general</h1>
      <p>Última actualización: {updated}. ¿Tienes dudas sobre un horario? <a href={whatsappHrefWithText('Hola, tengo una duda sobre el horario general.')} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>.</p>
    </section>

    <div class="scroller" data-reveal>
      <div class="grid" style={`--rows: ${grid.rows.length}`}>
        <div class="cell corner" style="grid-column: 1; grid-row: 1;"></div>
        {
          schedule.days.map((day, d) => (
            <div class="cell head" style={`grid-column: ${d + 2}; grid-row: 1;`} data-day={d}>
              {day}
            </div>
          ))
        }

        {
          grid.rows.map((row, pos) => (
            <div class="cell time" style={`grid-column: 1; grid-row: ${pos + 2};`}>
              {formatTimeRange(schedule.rows[row])}
            </div>
          ))
        }

        {
          schedule.sessions.map((session) => {
            const pos = grid.rowPosition.get(session.row)!;
            const meta = STYLE_META[session.style];
            return (
              <div
                class="cell session"
                style={`grid-column: ${session.day + 2}; grid-row: ${pos + 2} / span ${session.span}; background:${meta.bg}; color:${meta.fg};`}
                data-day={session.day}
              >
                <span class="icon" aria-hidden="true">
                  {session.icon}
                </span>
                <span class="text">{session.text}</span>
              </div>
            );
          })
        }
      </div>
    </div>
  </main>
</Page>

<style>
  .intro {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 3.5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2rem);
    text-align: center;
  }

  .intro h1 {
    color: var(--color-morado);
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
  }

  .intro p {
    margin: 0;
    color: color-mix(in srgb, var(--color-tinta) 75%, white);
  }

  .intro a {
    color: var(--color-magenta);
  }

  .scroller {
    max-width: 74rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4rem);
    overflow-x: auto;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(7rem, 8.5rem) repeat(6, minmax(8.5rem, 1fr));
    grid-auto-rows: minmax(3.25rem, auto);
    gap: 2px;
    min-width: 54rem;
    background: color-mix(in srgb, var(--color-morado) 10%, transparent);
    border-radius: 1rem;
    overflow: hidden;
  }

  .cell {
    background: var(--color-papel);
    padding: 0.6rem 0.5rem;
    display: flex;
    align-items: center;
  }

  .corner {
    background: var(--color-morado);
  }

  .head {
    justify-content: center;
    background: var(--color-morado);
    color: var(--color-papel);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .head[data-today] {
    background: var(--color-magenta);
  }

  .time {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-morado);
    background: var(--color-niebla);
  }

  .session {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    text-align: center;
    border-radius: 0.4rem;
  }

  .session .icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .session .text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.72rem;
    line-height: 1.3;
    white-space: pre-line;
  }
</style>
