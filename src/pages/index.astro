---
import Page from '../layouts/Page.astro';
import { getSchedule, groupByDiscipline, groupByCategory } from '../lib/schedule';
import { CONTACT } from '../lib/contact';

const schedule = await getSchedule();
const categories = groupByCategory(groupByDiscipline(schedule));

const highlights = [
  { icon: '🩰', text: 'De Baby Ballet a nivel juvenil' },
  { icon: '🎭', text: 'Danza, teatro y artes plásticas bajo un mismo techo' },
  { icon: '📅', text: 'Clases de lunes a sábado' },
  { icon: '✨', text: 'Clases particulares con previa cita' },
];
---

<Page>
  <main>
    <section class="hero">
      <div class="hero-shapes" aria-hidden="true">
        <span class="shape shape--magenta" data-hero-shape></span>
        <span class="shape shape--morado" data-hero-shape></span>
        <span class="shape shape--cian" data-hero-shape></span>
      </div>

      <div class="hero-content">
        <img
          class="hero-logo"
          src="/brand/spazio-vertical-color.svg"
          alt="Spazio Centro Artístico"
          width="446"
          height="374"
          data-hero-text
        />
        <h1 data-hero-text>Arte, disciplina y constancia</h1>
        <p class="hero-lead" data-hero-text>
          Academia de danza y artes en Huejotzingo, Puebla. Ballet, contemporáneo, ritmos latinos y talleres
          artísticos para todas las edades.
        </p>
        <div class="hero-cta" data-hero-text>
          <a class="btn btn-primary" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
            Escríbenos por WhatsApp
          </a>
          <a class="btn btn-ghost" href="/horarios">Ver horarios</a>
        </div>
      </div>
    </section>

    <section class="section" data-reveal aria-labelledby="why-heading">
      <h2 id="why-heading">Por qué Spazio</h2>
      <ul class="highlights">
        {
          highlights.map((item) => (
            <li>
              <span aria-hidden="true">{item.icon}</span>
              {item.text}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="disciplines-heading">
      <h2 id="disciplines-heading">Nuestras disciplinas</h2>
      <div class="categories" data-reveal-group>
        {
          [...categories.entries()].map(([category, disciplines]) => (
            <a class="category-card" href="/disciplinas">
              <span class="category-icon" aria-hidden="true">
                {disciplines[0].icon}
              </span>
              <span class="category-name">{category}</span>
              <span class="category-count">
                {disciplines.length} {disciplines.length === 1 ? 'clase' : 'clases'}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cta-band" data-reveal>
      <h2>Ven a conocernos</h2>
      <p>{CONTACT.address}</p>
      <a class="btn btn-primary" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
        Escríbenos por WhatsApp
      </a>
    </section>
  </main>
</Page>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(46rem, 92svh);
    padding: 2rem 1rem 3rem;
    overflow: hidden;
  }

  .hero-shapes {
    position: absolute;
    inset: 0;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    width: clamp(9rem, 26vw, 20rem);
    aspect-ratio: 1;
    opacity: 0.14;
  }

  .shape--magenta {
    top: -4rem;
    left: -3rem;
    background: var(--color-magenta);
    border-radius: 100% 0 0 0;
  }

  .shape--morado {
    right: -3rem;
    bottom: 4rem;
    background: var(--color-morado);
    border-radius: 0 0 100% 0;
  }

  .shape--cian {
    top: 20%;
    right: 14%;
    width: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-cian);
    border-radius: 50%;
    opacity: 0.45;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 40rem;
    text-align: center;
  }

  .hero-logo {
    width: min(70vw, 18rem);
    height: auto;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    margin: 0;
    color: var(--color-morado);
  }

  .hero-lead {
    margin: 0;
    color: color-mix(in srgb, var(--color-tinta) 75%, white);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--color-magenta);
    color: var(--color-papel);
  }

  .btn-primary:hover {
    background: var(--color-morado);
  }

  .btn-ghost {
    border: 2px solid var(--color-morado);
    color: var(--color-morado);
  }

  .btn-ghost:hover {
    background: var(--color-morado);
    color: var(--color-papel);
  }

  .section {
    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem);
  }

  .section h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    color: var(--color-morado);
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-niebla);
    border-radius: 1rem;
    font-weight: 500;
  }

  .highlights li span {
    font-size: 1.4rem;
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
  }

  .category-card {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.5rem 1rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-morado) 14%, transparent);
    text-align: center;
    text-decoration: none;
    color: var(--color-tinta);
  }

  .category-card:hover {
    border-color: var(--color-magenta);
  }

  .category-icon {
    font-size: 2rem;
  }

  .category-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-morado);
  }

  .category-count {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-tinta) 60%, white);
  }

  .cta-band {
    background: var(--color-niebla);
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem) 1.5rem;
  }

  .cta-band h2 {
    margin: 0 0 0.5rem;
    color: var(--color-morado);
  }

  .cta-band p {
    margin: 0 0 1.25rem;
    color: color-mix(in srgb, var(--color-tinta) 70%, white);
  }
</style>
