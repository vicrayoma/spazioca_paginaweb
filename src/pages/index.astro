---
import Base from '../layouts/Base.astro';
---

<Base>
  <main class="stage">
    <div class="shapes" aria-hidden="true">
      <span class="shape shape--magenta"></span>
      <span class="shape shape--morado"></span>
      <span class="shape shape--cian"></span>
    </div>

    <section class="content">
      <h1 class="sr-only">Spazio Centro Artístico</h1>
      <img
        class="logo"
        src="/brand/spazio-horizontal-color.svg"
        alt="Spazio Centro Artístico"
        width="642"
        height="198"
      />
      <p class="lema">Arte, disciplina y constancia</p>
      <p class="aviso">Estamos preparando nuestra nueva página.</p>
    </section>
  </main>
</Base>

<style>
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 2rem 1rem;
    overflow: hidden;
    background: var(--color-papel);
  }

  .content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .logo {
    width: min(86vw, 34rem);
    height: auto;
    animation: entrar 1.1s var(--ease-spazio) both;
  }

  .lema {
    margin: 0;
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-morado);
    animation: entrar 1.1s 0.15s var(--ease-spazio) both;
  }

  .aviso {
    margin: 0;
    color: color-mix(in srgb, var(--color-tinta) 70%, white);
    animation: entrar 1.1s 0.3s var(--ease-spazio) both;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Formas geométricas: cuartos de círculo que se superponen con multiply, como el isotipo. */
  .shapes {
    position: absolute;
    inset: 0;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    width: clamp(9rem, 26vw, 20rem);
    aspect-ratio: 1;
    opacity: 0.16;
    animation: flotar 14s ease-in-out infinite alternate;
  }

  .shape--magenta {
    top: -4rem;
    left: -3rem;
    background: var(--color-magenta);
    border-radius: 100% 0 0 0;
  }

  .shape--morado {
    right: -3rem;
    bottom: -3rem;
    background: var(--color-morado);
    border-radius: 0 0 100% 0;
    animation-delay: -5s;
  }

  .shape--cian {
    top: 18%;
    right: 12%;
    width: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-cian);
    border-radius: 50%;
    opacity: 0.5;
    animation-duration: 9s;
    animation-delay: -2s;
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes flotar {
    from {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    to {
      transform: translate3d(1.5rem, 1rem, 0) rotate(6deg);
    }
  }
</style>
