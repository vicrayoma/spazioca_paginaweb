---
import { CONTACT } from '../lib/contact';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <img class="mark" src="/brand/spazio-isotipo-blanco.svg" alt="" width="200" height="200" aria-hidden="true" />

    <div class="col">
      <p class="heading">Visítanos</p>
      <a class="line" href={CONTACT.mapsHref} target="_blank" rel="noopener noreferrer">
        {CONTACT.address}
      </a>
      <a class="line" href={CONTACT.whatsappHref} target="_blank" rel="noopener noreferrer">
        WhatsApp {CONTACT.whatsappDisplay}
      </a>
    </div>

    <div class="col">
      <p class="heading">Síguenos</p>
      <a class="line" href={CONTACT.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      {CONTACT.facebook && (
        <a class="line" href={CONTACT.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
      )}
    </div>
  </div>

  <p class="copy">© {year} Spazio Centro Artístico · Arte, disciplina y constancia</p>
</footer>

<style>
  .footer {
    background: var(--color-morado);
    color: var(--color-papel);
    padding: clamp(2rem, 6vw, 3.5rem) clamp(1rem, 4vw, 2.5rem) 1.5rem;
  }

  .inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .mark {
    position: absolute;
    right: 0;
    top: -0.5rem;
    width: clamp(4rem, 8vw, 6rem);
    height: auto;
    opacity: 0.35;
  }

  .heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-papel) 70%, transparent);
  }

  .line {
    display: block;
    color: var(--color-papel);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 22rem;
  }

  .line:hover {
    text-decoration: underline;
  }

  .copy {
    max-width: 64rem;
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-papel) 15%, transparent);
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--color-papel) 65%, transparent);
  }
</style>
